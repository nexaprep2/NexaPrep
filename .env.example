PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cbt_platform
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ADMIN_SECRET=change_this_to_a_different_long_random_secret
JWT_EXPIRES_IN=7d

# Admin login is driven entirely by these three — the server creates or
# updates this exact admin account on every restart to match whatever is
# set here. Change ADMIN_PASSWORD and restart the server to rotate it.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@nexaprep.local
ADMIN_PASSWORD=change_this_to_a_strong_password

SELF_URL=https://your-app-name.onrender.com
